{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qindun.chinmarket.cn/schema/qindun-trusted-key-directory-v2.schema.json",
  "title": "秦盾可信公钥目录 v2",
  "type": "object",
  "required": ["format", "issuer", "sequence", "previous_directory_digest", "generated_at", "expires_at", "keys"],
  "properties": {
    "format": {"const": "qindun-trusted-key-directory/v2"},
    "issuer": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_directory_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "public_key", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "public_key": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_until": {"type": ["string", "null"], "format": "date-time"},
          "retired_at": {"type": ["string", "null"], "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"},
          "reason": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
            "then": {
              "properties": {
                "retired_at": {"type": "null"},
                "revoked_at": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "retired"}}, "required": ["status"]},
            "then": {
              "required": ["retired_at"],
              "properties": {
                "retired_at": {"type": "string", "format": "date-time"},
                "revoked_at": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
            "then": {
              "required": ["revoked_at"],
              "properties": {
                "revoked_at": {"type": "string", "format": "date-time"}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "directory_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

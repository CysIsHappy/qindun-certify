{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinshield.cn/schemas/qindun-release-manifest-v1.schema.json",
  "title": "QinDun release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "skill_version", "source_commit", "archive", "files"],
  "properties": {
    "format": {"const": "qindun-release-manifest/v1"},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_commit": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^qindun-certify-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "mode"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 134217728},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"enum": ["0644", "0755"]}
        }
      }
    }
  }
}

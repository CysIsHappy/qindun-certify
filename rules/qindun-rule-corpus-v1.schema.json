{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinshield.cn/schemas/qindun-rule-corpus-v1.schema.json",
  "title": "秦盾规则正反例语料",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "bundle_version", "cases"],
  "properties": {
    "format": {"const": "qindun-rule-corpus/v1"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "positive", "negative"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^QINDUN\\.D[0-9]+\\.[A-Z0-9_]+$"},
          "positive": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "negative": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
